# Creates a commit with the changes in `data/`, if any. Must be run in the
# repo's root.

if [[ $(git status --porcelain data) ]]; then
  git config user.name 'Open Source Pledge GitHub Action Runner'
  git config user.email '<>'
  git add data
  git commit -m 'Add changes to data/ (automated commit)'
  git push
  echo "Changes to data/ committed"
else
  echo "No changes to data, skipping"
fi
