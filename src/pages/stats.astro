import fs from 'fs';
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';
dayjs.extend(utc);

import Blob from "../components/Blob.astro";
import Layout from "../layouts/Layout.astro";
import {
  getMembers,
  getAllTimeTotalRaised,
  getLastYearTotalRaised,
  fmtCurrency,
  sortMembersByDevs,
} from '../members/common.ts';

const activeMembers = getMembers();
const allMembers = getMembers({ includeInactive: true });
const maxNDevs = sortMembersByDevs(activeMembers)[0].annualReports[0].averageNumberOfDevs;
const allTimeTotal = Math.floor(getAllTimeTotalRaised(allMembers));
const lastYearTotal = Math.floor(getLastYearTotalRaised(activeMembers));
const membersByRenewalDate = activeMembers.map((member) => {
  return {
    member: member,
    renewalDate: dayjs(member.annualReports[0].reportDate).add(1, 'year'),
  };
}).toSorted((d1, d2) => {
  if (d2.renewalDate.isBefore(d1.renewalDate)) {
    return 1;
  }
  if (d2.renewalDate.isSame(d1.renewalDate)) {
    return 0;
  }
  return -1;
});

const tallyHistory = fs.readFileSync('./data/history.csv')
  .toString()
  .split('\n')
  .reverse()
  .map((line) => {
    const parts = line.split(',');
    return {
      date: parts[0],
      nMembers: +parts[1],
      lastYearTotal: +parts[2],
      allTimeTotal: +parts[3],
      maxNDevs: +parts[4],
    };
  });
---

<Layout
  title="Stats"
  preventIndexing={true}
>
  <div class="edge-blobs">
    <Blob kind="solid-fill-03" top="45%" right="-11rem"></Blob>
    <Blob kind="grad-dots-04" top="2%" right="-2rem"></Blob>
  </div>
  <div class="container">
    <Blob kind="solid-fill-04" top="4%" right="-22rem"></Blob>
    <Blob kind="solid-fill-02" top="25%" left="-22rem"></Blob>
    <Blob kind="solid-fill-05" top="65%" left="-7rem"></Blob>
    <Blob kind="grad-dots-02" top="80%" left="-16rem"></Blob>

    <main id="main-content">
      <section>
        <h1>Stats</h1>
        <article>
          <table class="table--bordered">
            <tr>
              <td>Number of members</td>
              <td>{activeMembers.length}</td>
            </tr>
            <tr>
              <td>Largest company by number of devs</td>
              <td>{maxNDevs}</td>
            </tr>
            <tr>
              <td>All-time total raised</td>
              <td>{fmtCurrency(allTimeTotal)}</td>
            </tr>
            <tr>
              <td>Rolling one-year total raised</td>
              <td>{fmtCurrency(lastYearTotal)}</td>
            </tr>
          </table>
          <h2>Chart of members and money raised</h2>
          <canvas id="main-chart"></canvas>
          <h2>Chart of largest company by number of devs</h2>
          <canvas id="devs-chart"></canvas>
          <h2>Members by renewal date</h2>
          <table class="members-table table--bordered table--lr">
            <thead>
              <tr>
                <th>Name</th>
                <th>Next renewal date</th>
              </tr>
            </thead>
            <tbody class="members">
              {membersByRenewalDate.map(({ member, renewalDate }) =>
                <tr class="member">
                  <td class="name">
                    <a class="sneaky" href={`/members/${member.id}`}>
                      <img src=`/images/members/${member.id}/logo.webp` alt=`The ${member.name} logo`>
                      {member.name}
                    </a>
                  </td>
                  <td>
                    {renewalDate.format('DD MMM YYYY')}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </article>
      </section>
    </main>
  </div>
</Layout>

<style>
  .members-table {
    margin: 0;
    td, th {
      padding-left: 0;
      padding-right: 0;
    }
    tr:has(td a:hover) td a {
      color: var(--color-secondary);
      text-decoration: none;
    }
    td {
      a {
        display: flex;
        align-items: center;
        padding: 5px 0;
      }
      img {
        max-width: 2.0rem;
        max-height: 100%;
        margin-right: 1rem;
      }
    }
  }
</style>

<script
  is:inline
  id="tallyHistory"
  type="application/json"
  set:html={JSON.stringify(tallyHistory)}
></script>

<script>
  import { Chart } from 'chart.js/auto';

  interface TallyHistoryItem {
    date: string;
    nMembers: number;
    lastYearTotal: number;
    allTimeTotal: number;
    maxNDevs: number;
  }

  type TallyHistory = TallyHistoryItem[];

  const tallyHistory = JSON.parse(document.getElementById('tallyHistory')!.innerText) as TallyHistory;

  const $mainChart = document.getElementById('main-chart')! as HTMLCanvasElement;
  const $devsChart = document.getElementById('devs-chart')! as HTMLCanvasElement;

  new Chart($mainChart, {
    type: 'bar',
    data: {
      labels: tallyHistory.map((d) => d.date),
      datasets: [
        {
          label: '№ members',
          data: tallyHistory.map((d) => d.nMembers),
          borderWidth: 1,
          yAxisID: 'members',
          type: 'line',
        },
        {
          label: 'Last year total',
          data: tallyHistory.map((d) => d.lastYearTotal),
          borderWidth: 1,
          yAxisID: 'dollars',
        },
        {
          label: 'All-time total',
          data: tallyHistory.map((d) => d.allTimeTotal),
          borderWidth: 1,
          yAxisID: 'dollars',
        },
      ]
    },
    options: {
      scales: {
        members: {
          type: 'linear',
          display: true,
          position: 'left',
        },
        dollars: {
          type: 'linear',
          display: true,
          position: 'right',
          ticks: {
            callback: (value: any) => {
              const formatter = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0,
              });
              return formatter.format(value.toString());
            }
          },
        },
      },
    },
  });

  new Chart($devsChart, {
    type: 'line',
    data: {
      labels: tallyHistory.map((d) => d.date),
      datasets: [
        {
          label: 'Max № devs',
          data: tallyHistory.map((d) => d.maxNDevs),
          borderWidth: 1,
        },
      ]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true,
        },
      }
    }
  });
</script>
